{
  "type": "commonjs",
  "dependencies": {
    "moment": "^2.30.1",
    "node-schedule": "^2.1.1",
    "iconv-lite": "^0.7.1"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');function deleteMapFiles(dir){fs.readdirSync(dir).forEach(file=>{const fullPath=path.join(dir,file);if(fs.statSync(fullPath).isDirectory())deleteMapFiles(fullPath);else if(file.endsWith('.map'))fs.unlinkSync(fullPath);})}deleteMapFiles('./node_modules');\""
  }
}